{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "app.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,tools/**,sample_reports/**,public/**,.venv/**,.pytest_cache/**,__pycache__/**,requirements-dev.txt,pytest.ini,launcher.py,run.py,backend_update.py,VALIDATION.md,TESTED_VERSIONS.txt}"
    }
  },
  "headers": [
    {
      "source": "/(app.css|app.js|bank-logo.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
